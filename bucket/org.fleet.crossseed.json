  "description": "Push completed downloads to other clients for seeding on the same data path.",
  "api": ">=1.0.0 <2.0.0",
  "homepage": "https://github.com/krate-apps/fleet-ext-crossseed",
  "source": {
    "repository": "https://github.com/krate-apps/fleet-ext-crossseed"
  },
  "checkver": {
    "github": "krate-apps/fleet-ext-crossseed"
  },
  "autoupdate": {
